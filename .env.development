DB_LOGGING = ["error"]

# 默认的超级管理员 账号/密码
SUPER_ADMIN = admin
SUPER_PASSWORD = admin_123

# redis
DB_HOST = localhost
REDIS_PORT = 6379
# REDIS_PASSWORD = 123456
REDIS_DB = 0

# smtp
