# logger
LOGGER_LEVEL = debug

# 菜单权限接口 未对接前， 暂时开启 
IS_PUBLIC = true

# security
JWT_SECRET = admin!@#TH
JWT_EXPIRE = 86400 # 单位秒
REFRESH_TOKEN_SECRET = admin!@#TH
REFRESH_TOKEN_EXPIRE = 2592000

# swagger
SWAGGER_ENABLE = true
SWAGGER_PATH = api-docs
SWAGGER_VERSION = 1.0
